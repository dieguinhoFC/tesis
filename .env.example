# Configuración de Notion y Groq para la Tesis

# 1. Token de Integración de Notion (Gratis en https://www.notion.so/my-integrations)
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. ID de la página padre donde se creará la Base de Datos en Notion
# (Es la cadena de 32 caracteres al final de la URL de tu página en Notion)
