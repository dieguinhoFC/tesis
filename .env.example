# 3. (Opcional) API Key de Groq para consultas por CLI con Llama 3.3 (Gratis en https://console.groq.com/keys)
GROQ_API_KEY=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
